{
  "TCP": { "80": { "HTTP": true }, "443": { "HTTPS": true } },
  "Web": {
    "${TS_CERT_DOMAIN}:80": {
      "Handlers": { "/": { "Redirect": "https://${TS_CERT_DOMAIN}${REQUEST_URI}" } }
    },
    "${TS_CERT_DOMAIN}:443": {
      "Handlers": { "/": { "Proxy": "http://host.docker.internal:7878" } }
    }
  }
}
